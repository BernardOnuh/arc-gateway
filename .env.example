DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
PORT=3000
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API. These may also send
# the dashboard session cookie; "*" allows any origin but disables cookie sessions.
CORS_ORIGINS=http://localhost:5173
# Dashboard session cookie. Secure defaults to on when NODE_ENV=production.
# Use SAMESITE=none (with SECURE=true) if the dashboard and API are on different sites.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax
