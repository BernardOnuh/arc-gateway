# ---- Copy to .env.production and fill in. Never commit the real file. ----
NODE_ENV=production
PORT=3000

# Database / cache. With docker-compose.prod.yml's own services:
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgres://gateway:change-me-to-a-long-random-string@postgres:5432/gateway
REDIS_URL=redis://redis:6379
# With managed services instead, e.g.:
# DATABASE_URL=postgres://user:pass@db.provider.com:5432/gateway?sslmode=require
# REDIS_URL=rediss://default:pass@redis.provider.com:6380

# Public URLs (https only in production; the API refuses to start otherwise).
PUBLIC_API_URL=https://api.example.com
APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
# Behind one load balancer / proxy:
TRUST_PROXY=1

# Session cookie. Lax works when app. and api. share a registrable domain
# (example.com). Use none (still Secure) if they are on different sites.
SESSION_COOKIE_SAMESITE=lax

# Live pricing and settlement on Arc mainnet.
QUOTE_PROVIDER=arc
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Circle App Kit key (recommended: the shared limit is low).
CIRCLE_API_KEY=

# Email (password reset). From address must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=ARC Gateway <no-reply@example.com>

LOG_LEVEL=info
# Leave unset: the legacy gateway-pays swap path stays off.
# ENABLE_GATEWAY_FUNDED_SUBMIT=false
